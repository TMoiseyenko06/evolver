# Copy to .env and fill in. The CLI loads .env automatically (found by walking up
# from the current directory). Real environment variables take precedence over
# values here.

# Required for `python -m evolver run`.
OPENROUTER_API_KEY=sk-or-...

# Optional: OpenRouter model slug (default: anthropic/claude-fable-5).
# EVOLVER_MODEL=anthropic/claude-fable-5

# Optional: where evolver.sqlite, runs/, and strategies/ live (default: .).
# EVOLVER_DATA_DIR=.

# Needed for `python -m evolver calibrate` (real orders via synthesis.trade), and
# read by `arb/` (market data) and `arbjs/` (market data + orders).
# SYNTHESIS_API_KEY=...
# SYNTHESIS_WALLET_ID=...
# SYNTHESIS_BASE_URL=https://synthesis.trade

# arbjs (the Node cross-venue arb bot) — see arbjs/README.md for the full list.
# Without ARBJS_LIVE=true it only prints the trades it would place.
# ARBJS_LIVE=true
# SYNTHESIS_KALSHI_WALLET_SEGMENT=      # wallet path segment for Kalshi orders
# ARBJS_TITLE_FILTER=bitcoin            # scan one family of markets instead of all
# ARBJS_MIN_PROFIT_CENTS=1
# ARBJS_TRADE_CENTS=500
